# Native Phase 1 runtime settings. Never commit populated secrets.
# compose.yaml is historical and has not been repointed to PostgreSQL.
# Set exactly ONE runtime source in the process environment. No owner/admin config.
# WORKFLOW_DATABASE_URL=postgresql://RUNTIME_ROLE:RUNTIME_PASSWORD@127.0.0.1:5432/DATABASE
# WORKFLOW_DATABASE_URL_FILE=/run/secrets/workflow-runtime-url
# The file contains one raw runtime URL, not allocation JSON.
# compose.postgres.yaml generates private credentials in separate volumes.
# Its public port overrides below may be put in a dedicated --env-file;
# they are not secrets or application process settings.
# WORKFLOW_PG_API_PORT=18000
# WORKFLOW_PG_TICKET_PORT=18001
# WORKFLOW_PG_INVENTORY_PORT=18002
# WORKFLOW_PG_DB_PORT=15432
# WORKFLOW_PG_REDIS_PORT=16379
# Keep the same Compose project and all six volumes across restarts.
WORKFLOW_REDIS_URL=redis://127.0.0.1:6379/0
WORKFLOW_REDIS_STREAM=workflow-pg-wakeups-v1
WORKFLOW_REDIS_GROUP=workflow-pg-workers-v1
# Standalone admission/approval/demo/load are unavailable pending identity/review.
# API keys and fabricated cookies grant no workflow access.
WORKFLOW_PLANNER=fixture
WORKFLOW_MODEL_URL=http://host.docker.internal:1234/v1
WORKFLOW_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
WORKFLOW_MODEL_REVISION=record-before-evaluation
WORKFLOW_MODEL_KEY=
